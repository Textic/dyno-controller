{
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.textic.dyno-controller\"",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.mjs",
        "validate": "streamdeck validate com.textic.dyno-controller.sdPlugin",
        "pack": "streamdeck pack com.textic.dyno-controller.sdPlugin --force",
        "link": "streamdeck link com.textic.dyno-controller.sdPlugin",
        "unlink": "streamdeck unlink com.textic.dyno-controller",
        "restart": "streamdeck restart com.textic.dyno-controller"
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.10.4",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~24.1.0",
        "@types/ws": "^8.18.2",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^3.0.0",
        "ws": "^8.23.0"
    }
}
